# --- Database (Supabase) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Engines (leave empty to run in MOCK mode) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
SERPAPI_KEY=            # Google AI Overviews / AI Mode via SERP provider
VIDALO_MOCK=1           # 1 = synthetic engine answers, no API calls
FREE_SCANS_PER_DAY=25   # live engines only: free scans the whole site may start per 24h (0 = none)

# --- Extraction model (cheap, used for claim extraction) ---
EXTRACTION_MODEL=gpt-4.1-mini
# --- Website assistant (/api/chat): OPENAI_API_KEY above; without it, answers come from the FAQ copy ---
CHAT_MODEL=gpt-4.1-mini

# --- Business resolution ---
GOOGLE_PLACES_API_KEY=
KVK_API_KEY=

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SETUP=      # one-off €149
STRIPE_PRICE_MONITOR=    # €49 / month
STRIPE_TAX_RATE_ID=      # 21% BTW, exclusive; live checkout refuses without it (pnpm stripe:setup)
VIDALO_STRIPE_ACCOUNT=   # acct_… that pnpm stripe:setup may touch; see docs/PAYMENTS.md

# --- Email ---
RESEND_API_KEY=
UNSUBSCRIBE_SECRET=     # signs the opt-out links in follow-up mails; without it (and VIDALO_MOCK=0) follow-ups are not sent
EMAIL_FROM="Vidalo <controle@vidalo.io>"

# --- Launch gate (go-live J4) ---
VIDALO_COMING_SOON=0        # 1 = marketing pages show /binnenkort (core/shared/gate.ts); legal, reports, account keep working
VIDALO_PREVIEW_KEY=         # with the button off: POST /api/preview with key=<this> opens the preview for one browser

# --- Publisher ---
PUBLIC_BASE_URL=http://localhost:3000
FACTS_HOST_SUFFIX=vidalo.io          # fallback host: {slug}.feiten.vidalo.io
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
INDEXNOW_KEY=
# Search Console for facts pages (publisher/google-index.ts): key of a service account in a Google Cloud
# project with the "Site Verification API" and "Google Search Console API" enabled. Raw JSON or base64.
# Empty: the index check is skipped (MAICRO_MOCK=1 runs a fake API instead).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Worker ---
FACTS_PORT=8787                      # facts pages served from the worker in dev
FACTS_CNAME_TARGET=                  # default feiten.{FACTS_HOST_SUFFIX}
WORKER_POLL_MS=2000
CRON_EVERY_MS=600000
VIDALO_OUT_DIR=out                   # mock mail (.eml), pages, operator queue
# WORKER_ONCE=1 WORKER_SEED=1        # dev: seed a demo business, drain the queue, exit
