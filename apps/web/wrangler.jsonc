// The web app as a Cloudflare Worker (OpenNext). Deployed only by
// .github/workflows/deploy.yml, by hand (workflow_dispatch). Never connect
// Cloudflare "Workers Builds": it deploys on every push.
//
// Secrets (DATABASE_URL, STRIPE_*, RESEND_API_KEY, ...) are set with
// `wrangler secret put`, never here; docs/secrets-and-keys.md lists them.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vidalo-web",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Adding routes turns workers.dev OFF silently (Sitty lost two deploys to
  // that), so it is written down: it stays on, as the address a deploy can
  // always be checked on even when DNS is wrong.
  "workers_dev": true,
  // vidalo.io is the site (registered 14 Oct 2026; .nl and .com are held by
  // others). www is bound to the same Worker and answers with a 301 to
  // vidalo.io (worker.ts, core/shared/canonical.ts, which lists the same
  // host). Custom Domains create their own DNS records and certificates; the
  // zone must be active in A101's Cloudflare account first, or the deploy
  // fails naming the zone.
  "routes": [
    { "pattern": "vidalo.io", "custom_domain": true },
    { "pattern": "www.vidalo.io", "custom_domain": true }
  ],
  // VIDALO_COMING_SOON=1 is the launch gate (go-live J4): marketing pages show
  // /binnenkort. VIDALO_PREVIEW_BUTTON=1 is the temporary button on that page
  // that lets anyone walk the site; set it to "0" before launch, then the
  // preview only opens with VIDALO_PREVIEW_KEY (a secret, `wrangler secret put`).
  "vars": { "VIDALO_MOCK": "0", "PUBLIC_BASE_URL": "https://vidalo.io", "VIDALO_COMING_SOON": "1", "VIDALO_PREVIEW_BUTTON": "1" },
  // Hyperdrive pools the Supabase connections (one handle per request,
  // worker.ts). `vidalo-db`, created in the dashboard 16 Oct 2026: Supabase
  // session pooler aws-0-eu-west-1.pooler.supabase.com:5432, user
  // postgres.bbynmqvaxpjdnkaasutd. The preview env has no database.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "8095400e14134f9391067cbf78416cd6" }],
  // Free scans go to the background worker through this queue.
  "queues": { "producers": [{ "binding": "SCAN_QUEUE", "queue": "vidalo-scans" }] },
  "env": {
    // Mock data, no keys, no database: the site as it looks today, on Cloudflare.
    "preview": {
      "name": "vidalo-web-preview",
      "workers_dev": true,
      // routes are inherited by an environment: without this the preview
      // would try to claim vidalo.io.
      "routes": [],
      "vars": { "VIDALO_MOCK": "1", "PUBLIC_BASE_URL": "https://vidalo-web-preview.julian-devriend.workers.dev", "VIDALO_COMING_SOON": "0", "VIDALO_PREVIEW_BUTTON": "0" },
      "hyperdrive": [],
      "queues": { "producers": [] }
    }
  }
}
