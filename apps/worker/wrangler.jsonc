// The background worker as a Cloudflare Worker (src/cloudflare.ts): jobs,
// the cron tick, free scans from the website, and customers' facts pages.
// Deployed only by .github/workflows/deploy.yml, by hand. Never connect
// Cloudflare "Workers Builds". Secrets via `wrangler secret put`; the list is
// in docs/secrets-and-keys.md.
{
  "$schema": "../web/node_modules/wrangler/config-schema.json",
  "name": "vidalo-worker",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "vars": { "VIDALO_MOCK": "0", "FACTS_HOST_SUFFIX": "vidalo.io" },
  // Facts pages (docs/go-live-checklist.md D5, D6). Production only: env.staging
  // sets "routes": [] so it never touches vidalo.io.
  //   feiten.vidalo.io      the CNAME target and Cloudflare for SaaS fallback
  //                         origin (its proxied DNS record is set by hand)
  //   *-feiten.vidalo.io    fallback hosts {slug}-feiten.vidalo.io (wildcard
  //                         DNS record `*`, proxied, set by hand)
  // Customers' own feiten.{domain} hosts each get a route `{host}/*` from
  // publisher/host.ts when their custom hostname is created. No `*/*`: a route
  // beats a Custom Domain on the same hostname and would take vidalo.io and
  // www.vidalo.io from vidalo-web.
  "routes": [
    { "pattern": "feiten.vidalo.io/*", "zone_name": "vidalo.io" },
    { "pattern": "*-feiten.vidalo.io/*", "zone_name": "vidalo.io" }
  ],
  "triggers": {
    // Every minute: run queued jobs. Every ten minutes: the cron tick
    // (monthly scans, rechecks, host polls, follow-ups). src/cloudflare.ts
    // tells them apart by the expression.
    "crons": ["* * * * *", "*/10 * * * *"]
  },
  "queues": {
    "consumers": [{ "queue": "vidalo-scans", "max_batch_size": 1, "max_retries": 2 }]
  },
  // Same Hyperdrive as apps/web/wrangler.jsonc (vidalo-db, 16 Oct 2026).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "8095400e14134f9391067cbf78416cd6" }],
  "env": {
    // Staging: same code, crons and settings as production, its own queue and
    // database (apps/web/wrangler.jsonc, env.staging). Give it no RESEND_API_KEY
    // and no CLOUDFLARE_API_TOKEN: without them it sends no mail and creates
    // no facts hosts. Hyperdrive stays empty until the staging database exists;
    // the worker then refuses to run rather than use mock data.
    "staging": {
      "name": "vidalo-worker-staging",
      "workers_dev": true,
      // routes inherit from the top level; staging never answers on vidalo.io.
      "routes": [],
      "vars": { "VIDALO_MOCK": "0", "FACTS_HOST_SUFFIX": "vidalo.io" },
      "triggers": { "crons": ["* * * * *", "*/10 * * * *"] },
      "queues": {
        "consumers": [{ "queue": "vidalo-scans-staging", "max_batch_size": 1, "max_retries": 2 }]
      },
      "hyperdrive": []
    }
  }
}
