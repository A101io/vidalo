{
  "$comment": "Every secret Vidalo uses: where it comes from, where it goes, whether it spends money. Values live only in the root .env (gitignored) and on the Workers; scripts/secrets-push.mjs moves them without printing them. Control Room A10.",
  "workers": { "web": "vidalo-web", "worker": "vidalo-worker" },
  "secrets": [
    { "name": "SUPABASE_URL", "targets": ["web", "worker"], "feature": "sign-in, database client", "source": "https://supabase.com/dashboard/project/bbynmqvaxpjdnkaasutd/settings/api" },
    { "name": "SUPABASE_ANON_KEY", "targets": ["web"], "feature": "sign-in", "source": "https://supabase.com/dashboard/project/bbynmqvaxpjdnkaasutd/settings/api-keys" },
    { "name": "SUPABASE_SERVICE_ROLE_KEY", "targets": ["web", "worker"], "feature": "delete a login, owner linking, jobs", "source": "https://supabase.com/dashboard/project/bbynmqvaxpjdnkaasutd/settings/api-keys" },
    { "name": "DATABASE_URL", "targets": [], "feature": "local only: production reaches the database through Hyperdrive vidalo-db", "source": "Supabase → Connect → session pooler" },
    { "name": "TURNSTILE_SITE_KEY", "targets": ["web"], "feature": "bot check on the free check and sign-in", "source": "https://dash.cloudflare.com/37c9615a0d7d9629154eca03d7de59a6/turnstile", "forbidInProduction": ["^[123]x0000"] },
    { "name": "TURNSTILE_SECRET_KEY", "targets": ["web"], "feature": "bot check on the free check and sign-in", "source": "https://dash.cloudflare.com/37c9615a0d7d9629154eca03d7de59a6/turnstile", "forbidInProduction": ["^[123]x0000"] },
    { "name": "RESEND_API_KEY", "targets": ["web", "worker"], "feature": "all mail", "source": "https://resend.com/api-keys (Sending access, domain vidalo.io)", "requirePrefix": "re_" },
    { "name": "UNSUBSCRIBE_SECRET", "targets": ["web", "worker"], "feature": "unsubscribe links, the same value on both", "source": "openssl rand -hex 32" },
    { "name": "STRIPE_SECRET_KEY", "targets": ["web"], "feature": "checkout, portal, cancel and pause", "source": "https://dashboard.stripe.com/apikeys (account Vidalo)", "liveOnlyWith": "--live" },
    { "name": "STRIPE_WEBHOOK_SECRET", "targets": ["web"], "feature": "payments start the service", "source": "printed by pnpm stripe:setup --apply", "requirePrefix": "whsec_" },
    { "name": "STRIPE_PRICE_SETUP", "targets": ["web"], "feature": "checkout", "source": "pnpm stripe:setup" },
    { "name": "STRIPE_PRICE_MONITOR", "targets": ["web"], "feature": "checkout", "source": "pnpm stripe:setup" },
    { "name": "STRIPE_TAX_RATE_ID", "targets": ["web"], "feature": "checkout (live refuses without it)", "source": "pnpm stripe:setup" },
    { "name": "STRIPE_PORTAL_CONFIGURATION", "targets": ["web"], "feature": "invoices portal", "source": "pnpm stripe:setup" },
    { "name": "VIDALO_STRIPE_ACCOUNT", "targets": [], "feature": "local only: pins the setup script to Vidalo's Stripe account", "source": "acct_1UR4QnEKzmvgQ7J9" },
    { "name": "OPENAI_API_KEY", "targets": ["web", "worker"], "feature": "ChatGPT checks, extraction, the site assistant", "source": "https://platform.openai.com/api-keys", "spends": true },
    { "name": "GOOGLE_PLACES_API_KEY", "targets": ["web"], "feature": "business lookup on the free check", "source": "https://console.cloud.google.com/apis/credentials (vidalo-places)", "spends": true },
    { "name": "GEMINI_API_KEY", "targets": ["worker"], "feature": "Gemini checks", "source": "https://aistudio.google.com/apikey", "spends": true },
    { "name": "PERPLEXITY_API_KEY", "targets": ["worker"], "feature": "Perplexity checks", "source": "https://www.perplexity.ai/account/api/keys", "spends": true },
    { "name": "SERPAPI_KEY", "targets": ["worker"], "feature": "Google AI answers", "source": "https://serpapi.com/manage-api-key", "spends": true },
    { "name": "ANTHROPIC_API_KEY", "targets": ["worker"], "feature": "Claude checks", "source": "https://console.anthropic.com/settings/keys", "spends": true },
    { "name": "KVK_API_KEY", "targets": ["web"], "feature": "KvK lookup (optional)", "source": "https://developers.kvk.nl", "spends": true },
    { "name": "GOOGLE_OAUTH_CLIENT_ID", "targets": ["web"], "feature": "ownership proof with Google", "source": "https://console.cloud.google.com/auth/clients" },
    { "name": "GOOGLE_OAUTH_CLIENT_SECRET", "targets": ["web"], "feature": "ownership proof with Google", "source": "https://console.cloud.google.com/auth/clients" },
    { "name": "GOOGLE_SERVICE_ACCOUNT_JSON", "targets": ["worker"], "feature": "Google index check (optional)", "source": "Google Cloud → IAM → service account key" },
    { "name": "INDEXNOW_KEY", "targets": ["worker"], "feature": "IndexNow on facts hosts", "source": "openssl rand -hex 16" }
  ]
}
